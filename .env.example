# Supabase → Project Settings → API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL publique du site (utilisée dans les liens de connexion envoyés par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuseau qui définit « aujourd'hui » (les serveurs Vercel sont en UTC)
NEXT_PUBLIC_APP_TIMEZONE=Europe/Paris
