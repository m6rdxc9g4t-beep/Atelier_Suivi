  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "local": "bash scripts/macos/start-local.sh",
    "local:stop": "npx -y supabase stop",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
